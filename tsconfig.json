{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "Node16",
		"target": "ES2020",
		"allowJs": true,
		"strict": true,
		"esModuleInterop": true,
		"moduleResolution": "node16",
		"ignoreDeprecations": "6.0",
		"lib": ["ES2020", "DOM"],
		"skipLibCheck": true,
		"noEmit": false,
		"outDir": "dist"
	},
	"include": ["**/*.ts", "**/*.d.ts"],
	"exclude": ["node_modules", "dist"]
}